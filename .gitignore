########################
# Root .gitignore
# Covers both frontend (Vite/React) and backend (FastAPI/Python)
########################

# Node / frontend dependencies
node_modules/

# Python / backend virtual envs
venv/
frontend/venv/
backend/venv/

# Python bytecode
__pycache__/
*.py[cod]
*.pyo

# Environment variables (all env files in project)
.env
.env.*

# macOS
.DS_Store

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Build output
dist/
build/

# Vite / tooling caches
.vite/
.eslintcache

# Test coverage
coverage/
.nyc_output/

# IDE / editor
.vscode/
.idea/
*.swp
*.swo
